        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Toute l’analyse a lieu sur ton iPhone — rien n’est envoyé en ligne." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "解析はすべて iPhone 上で実行され、何もアップロードされません。" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Всё сканирование происходит на твоём iPhone — ничего не отправляется наружу." } }
