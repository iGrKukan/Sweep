    "All scanning happens on your iPhone — nothing is uploaded." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die gesamte Analyse läuft auf deinem iPhone — nichts wird hochgeladen." } },
