      }
    },
    "Full access lets us see duplicates across your entire library, not just a subset." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Mit vollem Zugriff sehen wir Duplikate in deiner gesamten Mediathek, nicht nur in einem Ausschnitt." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Full access lets us see duplicates across your entire library, not just a subset." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "L’accès complet permet de voir les doublons dans toute ta photothèque, pas juste une sélection." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "フルアクセスにすると、ライブラリ全体の重複を検出できます。" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Полный доступ позволяет искать дубли по всей библиотеке, а не по выборке." } }
      }
    },
    "Grant access so Sweep can find duplicates, blurry shots and old screenshots." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Gewähre Zugriff, damit Sweep Duplikate, unscharfe Fotos und alte Screenshots finden kann." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Grant access so Sweep can find duplicates, blurry shots and old screenshots." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Autorise l’accès pour que Sweep puisse trouver doublons, flous et anciens screenshots." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "アクセスを許可すると、重複・ぼけ・古いスクリーンショットを検出できます。" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Разреши доступ, чтобы Sweep нашёл дубли, размытые кадры и старые скриншоты." } }
