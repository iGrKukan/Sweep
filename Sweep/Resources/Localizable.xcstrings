    "Coming soon: unlock unlimited deletion + smart suggestions for $9.99 (one-time)." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Bald: unbegrenztes Löschen + smarte Vorschläge für 9,99 $ (einmalig)." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Coming soon: unlock unlimited deletion + smart suggestions for $9.99 (one-time)." } },
